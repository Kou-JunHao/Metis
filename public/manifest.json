{
  "manifest_version": 3,
  "name": "Metis New Tab",
  "version": "1.0",
  "description": "A modern, customizable new tab page with reliable wallpapers, quick links, and a lightweight task list.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.bing.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "metis-new-tab@example.com",
      "strict_min_version": "109.0"
    }
  }
}
